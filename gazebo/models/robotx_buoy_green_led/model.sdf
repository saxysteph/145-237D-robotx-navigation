<?xml version="1.0"?>
<sdf version="1.10">
  <model name="robotx_buoy_green_led">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>
    <!-- Controlled bobbing for stable, realistic motion without toppling -->
    <plugin filename="librobotx_bobbing_plugin.dylib" name="robotx::BobbingPlugin">
      <amplitude_z_m>0.03</amplitude_z_m>
      <frequency_hz>0.18</frequency_hz>
      <drift_xy_m>0.02</drift_xy_m>
      <drift_frequency_hz>0.025</drift_frequency_hz>
      <roll_deg>0.4</roll_deg>
      <pitch_deg>0.5</pitch_deg>
      <phase_rad>2.1</phase_rad>
    </plugin>
    <link name="body_link">
      <gravity>false</gravity>
      <enable_wind>false</enable_wind>
      <collision name="body_collision_lower">
        <pose>0 0 0.28 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.40</radius>
            <length>0.56</length>
          </cylinder>
        </geometry>
      </collision>
      <collision name="body_collision_mid">
        <pose>0 0 0.62 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
      </collision>
      <collision name="body_collision_upper">
        <pose>0 0 0.82 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
      </collision>
      <collision name="body_collision_collar">
        <pose>0 0 0.98 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.23</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="body_visual_lower">
        <pose>0 0 0.28 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.40</radius>
            <length>0.56</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <visual name="body_visual_mid">
        <pose>0 0 0.62 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.32</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <visual name="body_visual_upper">
        <pose>0 0 0.82 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <visual name="body_visual_collar">
        <pose>0 0 0.98 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.23</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>

      <visual name="beacon_cap">
        <pose>0 0 1.18 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.20</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.22 0.02 1</ambient>
          <diffuse>0.06 0.78 0.06 1</diffuse>
          <emissive>0.12 1.00 0.12 1</emissive>
        </material>
      </visual>
      <light name="top_beacon" type="spot">
        <pose>0 0 1.21 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <diffuse>0 1 0 1</diffuse>
        <specular>0.0 0.4 0.0 1</specular>
        <attenuation>
          <range>55</range>
          <constant>0.20</constant>
          <linear>0.02</linear>
          <quadratic>0.0015</quadratic>
        </attenuation>
        <direction>0 0 1</direction>
        <spot>
          <inner_angle>0.16</inner_angle>
          <outer_angle>0.30</outer_angle>
          <falloff>1.4</falloff>
        </spot>
      </light>
    </link>
  </model>
</sdf>
