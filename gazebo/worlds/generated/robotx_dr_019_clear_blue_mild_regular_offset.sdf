    <model name="uav_dataset_camera">
      <static>false</static>
      <pose>0 0 26 0 0 0</pose>
      <plugin filename="librobotx_overhead_motion_plugin.dylib" name="robotx::OverheadMotionPlugin">
        <radius_x_m>13.73380</radius_x_m>
        <radius_y_m>9.81821</radius_y_m>
