          <always_on>true</always_on>
          <update_rate>20</update_rate>
          <pose>0 0 0 0 1.57079632679 0</pose>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
              <format>R8G8B8</format>
            </image>
            <clip>
